Output "demo.gif"
Set FontSize 22
Set Width 1200
Set Height 1000
Set Padding 20
Set Theme "Monokai Soda"

Set Shell powershell

# El servidor debe de estar escuchando.

Hide
Type "just run-client"
Enter
Sleep 4s
Show

Sleep 3s
Type "Evan"
Sleep 1s
Enter
Sleep 1.5ms
Type "3"
Enter
Sleep 2s
Type "Hello to everyone"
Enter
Sleep 2s
Type "This is a demo of the chat"
Enter
Sleep 2s
Escape
Type "q"

